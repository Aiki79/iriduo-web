{
  "expo": {
    "name": "IriDuo",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1A2B",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.emergent.creaapp.zyjh8m",
      "infoPlist": {
        "NSCameraUsageDescription": "Trasmetti il tuo video 3D al visore",
        "NSMicrophoneUsageDescription": "Fatti sentire durante la videochiamata 3D",
        "NSMotionUsageDescription": "Guardati intorno muovendo il telefono"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#243757"
      },
      "package": "com.emergent.creaapp.zyjh8m",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E1A2B"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      "@react-native-vector-icons/feather",
      [
        "expo-camera",
        {
          "cameraPermission": "Trasmetti il tuo video 3D al visore",
          "microphonePermission": "Fatti sentire durante la videochiamata 3D",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Guardati intorno muovendo il telefono"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
